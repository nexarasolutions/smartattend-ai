  USERS ||--o| STAFF : identifies
  CLASS_SECTIONS ||--o{ STUDENTS : contains
  SUBJECTS ||--o{ STAFF_SUBJECT_ASSIGNMENTS : assigned
  STAFF ||--o{ STAFF_SUBJECT_ASSIGNMENTS : teaches
  CLASS_SECTIONS ||--o{ STAFF_SUBJECT_ASSIGNMENTS : scopes
  SUBJECTS ||--o{ CLASS_SESSIONS : scheduled
  CLASS_SECTIONS ||--o{ CLASS_SESSIONS : hosts
  STAFF ||--o{ CLASS_SESSIONS : leads
