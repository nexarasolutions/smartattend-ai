{
  "openapi": "3.0.3",
  "info": {
    "title": "SmartAttend AI API",
    "version": "1.0.0",
    "description": "API documentation for SmartAttend AI. Request and response details for each endpoint should be confirmed against the deployed API."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Attendance"
    },
    {
      "name": "Devices"
    }
  ],
  "paths": {
    "/_app/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "Service is running"
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Database readiness check",
        "responses": {
          "200": {
            "description": "Database is ready"
          },
          "503": {
            "description": "Database is unavailable or not configured"
          }
        }
      }
    },
    "/api/system/status": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service configuration status",
        "responses": {
          "200": {
            "description": "System status"
          }
        }
      }
    },
    "/api/attendance": {
      "get": {
        "tags": [
          "Attendance"
        ],
        "summary": "List attendance records",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Attendance records"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient role"
          }
        }
      },
      "post": {
        "tags": [
          "Attendance"
        ],
        "summary": "Mark attendance (staff/admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Attendance result"
          },
          "201": {
            "description": "Attendance created"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient role"
          }
        }
      }
    },
    "/api/attendance/sessions": {
      "get": {
        "tags": [
          "Attendance"
        ],
        "summary": "List attendance sessions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Attendance sessions"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      },
      "post": {
        "tags": [
          "Attendance"
        ],
        "summary": "Create attendance session (staff/admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient role"
          }
        }
      }
    },
    "/api/device/register": {
      "post": {
        "tags": [
          "Devices"
        ],
        "summary": "Register a Raspberry Pi attendance device",
        "parameters": [
          {
            "name": "X-Device-Enrollment-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "device_id"
                ],
                "properties": {
                  "device_id": {
                    "type": "string"
                  },
                  "firmware_version": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device registered"
          },
          "201": {
            "description": "Device registered"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid enrollment token"
          }
        }
      }
    },
    "/api/device/heartbeat": {
      "post": {
        "tags": [
          "Devices"
        ],
        "summary": "Send device heartbeat",
        "security": [
          {
            "deviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Heartbeat accepted"
          },
          "401": {
            "description": "Device authentication failed"
          }
        }
      }
    },
    "/api/device/attendance": {
      "post": {
        "tags": [
          "Devices"
        ],
        "summary": "Submit a device attendance event",
        "security": [
          {
            "deviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event accepted"
          },
          "400": {
            "description": "Invalid event"
          },
          "401": {
            "description": "Device authentication failed"
          }
        }
      }
    },
    "/api/device/status": {
      "get": {
        "tags": [
          "Devices"
        ],
        "summary": "Get authenticated device status",
        "security": [
          {
            "deviceToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Device status"
          },
          "401": {
            "description": "Device authentication failed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase JWT for user-facing API endpoints."
      },
      "deviceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Use the device credential format configured by the backend."
      }
    }
  }
}
