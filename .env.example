# ============================================================
# SmartAttend AI — Environment Variables
# Copy to .env for local development. Never commit .env.
# ============================================================

# --- LOCAL DEV ONLY ---
FLASK_APP=backend.wsgi:app
PORT=5001
SMARTATTEND_COOKIE_SECURE=false
SMARTATTEND_REQUIRE_HTTPS=false

# --- SUPABASE (get from Supabase Dashboard → Settings → API) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- DATABASE (Supabase Dashboard → Settings → Database → URI) ---
# Use the "URI" connection string (starts with postgresql://)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# --- BACKEND SECRETS ---
SMARTATTEND_JWT_SECRET=replace-with-random-32-byte-secret
SMARTATTEND_BOOTSTRAP_TOKEN=replace-with-one-time-admin-token

# --- CORS (comma-separated list of allowed frontend origins) ---
SMARTATTEND_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- FRONTEND (Vite env vars — must start with VITE_) ---
# Set these in Vercel Dashboard → Settings → Environment Variables
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_API_BASE_URL=https://your-render-app.onrender.com/api

# Optional timing
SMARTATTEND_HEARTBEAT_OFFLINE_SECONDS=300
